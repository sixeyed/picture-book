---js
{
  // js front matter so computed values are plain strings — YAML template
  // strings ("{{ gig.title }}") are rendered (and autoescaped) once at
  // computed-data time and then escaped again by base.njk, double-escaping
  // titles containing & or quotes.
  pagination: { data: "gigs", size: 1, alias: "gig" },
  permalink: (data) => `/${data.gig.slug}/`,
  layout: "base.njk",
  eleventyComputed: {
    title: (data) => data.gig.title,
    needsGallery: true,
    ogImage: (data) => `${data.site.url}/img/web/${data.gig.slug}/${data.gig.cover}`,
  },
}
---
<h1>{{ gig.title }}</h1>
<p class="meta">
  {%- for a in gig.artists -%}
    {{ a.name }}
    {%- for l in a.links %} <a class="chip" href="{{ l.url }}">{{ l.label }}</a>{% endfor -%}
    {%- if not loop.last %} · {% endif -%}
  {%- endfor %} ·
  {{ gig.venue.name }}
  {%- for l in gig.venue.links %} <a class="chip" href="{{ l.url }}">{{ l.label }}</a>{% endfor %} ·
  {{ gig.venue.location }} · {{ gig.date | displayDate }}
</p>
{% if gig.description %}<p class="blurb">{{ gig.description }}</p>{% endif %}
<div class="columns" data-download="{{ 'true' if gig.permission != 'display-only' else 'false' }}">
  {% for col in gig.columnGroups %}
  <div class="col" style="flex: {{ gig.layout.widths[loop.index0] }}">
    {% for img in col %}
    <a class="thumb" href="/img/web/{{ gig.slug }}/{{ img.file }}"
       data-order="{{ img.order }}"
       data-stem="{{ img.stem }}"
       {% if gig.permission != "display-only" %}data-full="/img/full/{{ gig.slug }}/{{ img.file }}"{% endif %}
       style="aspect-ratio: {{ img.width }} / {{ img.height }}">
      <img src="{{ img.thumbSrc }}" srcset="{{ img.thumbSrcset }}"
           sizes="(max-width: 700px) 100vw, (min-width: 1400px) 460px, 33vw"
           alt="{{ gig.title }}"
           width="{{ img.thumbWidth }}" height="{{ img.thumbHeight }}" loading="lazy" decoding="async">
    </a>
    {% endfor %}
  </div>
  {% endfor %}
</div>
